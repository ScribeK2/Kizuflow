<%# Written for the admin in the app (Q4): numbers first, one line saying what
    they mean, and everything that needs a shell behind one disclosure at the
    bottom. Sections run in the order an admin needs them (Q54). %>
<div class="page-content admin-health">
  <div class="page-header-section">
    <div>
      <h1 class="page-header-section__title">Data Health</h1>
      <p class="page-header-section__subtitle">Whether the nightly jobs run, and what TurboFlows keeps and clears away.</p>
    </div>
  </div>

  <%= render "background_jobs", attention: admin_attention %>

  <section class="list-section" id="runs-and-retention">
    <div class="list-section__head"><h2 class="list-section__title">Runs and Retention</h2></div>
    <p class="admin-health__hint">
      Runs nobody finished are settled as abandoned once idle past the timeout, which is what lets
      retention delete them. Unfinished runs should stay flat; if the number keeps climbing, the nightly
      sweep is missing something.
    </p>
    <div class="stat-panel">
      <div class="stat-panel__grid">
        <div class="stat-cell">
          <span class="stat-cell__label">Unfinished runs</span>
          <span class="stat-cell__value"><%= number_with_delimiter(@run_stats[:outstanding]) %></span>
        </div>
        <div class="stat-cell">
          <span class="stat-cell__label">Idle timeout</span>
          <span class="stat-cell__value"><%= @run_stats[:idle_timeout_hours] %> hours</span>
        </div>
        <div class="stat-cell">
          <span class="stat-cell__label">Live runs kept</span>
          <span class="stat-cell__value"><%= @run_stats[:live_days] %> days</span>
        </div>
        <div class="stat-cell">
          <span class="stat-cell__label">Test runs kept</span>
          <span class="stat-cell__value"><%= @run_stats[:simulation_days] %> days</span>
        </div>
      </div>
    </div>
  </section>

  <section class="list-section" id="drafts">
    <div class="list-section__head"><h2 class="list-section__title">Drafts</h2></div>
    <div class="admin-card__action-row admin-health__hint-row">
      <p class="admin-health__hint">
        Expired and orphaned drafts are removed every night. A draft with steps is never removed.
      </p>
      <%= button_to "Clean Up Now", admin_data_health_cleanup_drafts_path, class: "btn btn--secondary btn--sm",
            form: { data: { turbo_confirm: "Delete every expired and orphaned draft now?" } } %>
    </div>
    <div class="stat-panel">
      <div class="stat-panel__grid admin-health__grid--3">
        <div class="stat-cell">
          <span class="stat-cell__label">Drafts</span>
          <span class="stat-cell__value"><%= number_with_delimiter(@draft_stats[:total]) %></span>
        </div>
        <div class="stat-cell">
          <span class="stat-cell__label">Expired</span>
          <span class="stat-cell__value"><%= number_with_delimiter(@draft_stats[:expired]) %></span>
          <span class="stat-cell__detail">Untouched for 7 days, no steps</span>
        </div>
        <div class="stat-cell">
          <span class="stat-cell__label">Orphaned</span>
          <span class="stat-cell__value"><%= number_with_delimiter(@draft_stats[:orphaned]) %></span>
          <span class="stat-cell__detail">Untitled, no steps, over a day old</span>
        </div>
      </div>
    </div>
  </section>

  <section class="list-section" id="versions">
    <div class="list-section__head"><h2 class="list-section__title">Versions</h2></div>
    <p class="admin-health__hint">
      Every published version is kept as a record. The newest <%= @version_stats[:restore_limit] %> of each
      workflow stay restorable; older ones give up their saved steps on the next publish.
    </p>
    <div class="stat-panel">
      <div class="stat-panel__grid">
        <div class="stat-cell">
          <span class="stat-cell__label">Versions</span>
          <span class="stat-cell__value"><%= number_with_delimiter(@version_stats[:total]) %></span>
        </div>
        <div class="stat-cell">
          <span class="stat-cell__label">Restorable</span>
          <span class="stat-cell__value"><%= number_with_delimiter(@version_stats[:restorable]) %></span>
        </div>
        <div class="stat-cell">
          <span class="stat-cell__label">Released</span>
          <span class="stat-cell__value"><%= number_with_delimiter(@version_stats[:released]) %></span>
        </div>
        <div class="stat-cell">
          <span class="stat-cell__label">Most per workflow</span>
          <span class="stat-cell__value"><%= number_with_delimiter(@version_stats[:max_per_workflow]) %></span>
        </div>
      </div>
    </div>
  </section>

  <section class="list-section" id="storage">
    <div class="list-section__head"><h2 class="list-section__title">Storage</h2></div>
    <p class="admin-health__hint">Records in the tables that grow.</p>
    <div class="stat-panel">
      <div class="stat-panel__grid">
        <% @storage.each do |table| %>
          <div class="stat-cell">
            <span class="stat-cell__label"><%= table[:label] %></span>
            <span class="stat-cell__value"><%= number_with_delimiter(table[:count]) %></span>
            <% if table[:size] %>
              <span class="stat-cell__detail"><%= table[:size] %> on disk</span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <details class="admin-disclosure admin-health__server" id="server">
    <summary class="admin-disclosure__summary">For whoever runs the server</summary>
    <div class="admin-health__server-body">
      <h3 class="admin-health__server-heading">Settings</h3>
      <dl class="admin-health__settings">
        <div>
          <dt><code>SCENARIO_IDLE_TIMEOUT_HOURS</code></dt>
          <dd><%= @run_stats[:idle_timeout_hours] %> &mdash; hours before an unfinished run is settled as abandoned</dd>
        </div>
        <div>
          <dt><code>SCENARIO_RETENTION_LIVE_DAYS</code></dt>
          <dd><%= @run_stats[:live_days] %> &mdash; days live runs are kept</dd>
        </div>
        <div>
          <dt><code>SCENARIO_RETENTION_SIMULATION_DAYS</code></dt>
          <dd><%= @run_stats[:simulation_days] %> &mdash; days test runs are kept</dd>
        </div>
        <div>
          <dt><code>WORKFLOW_VERSION_RESTORE_LIMIT</code></dt>
          <dd><%= @version_stats[:restore_limit] %> &mdash; restorable versions per workflow</dd>
        </div>
      </dl>

      <h3 class="admin-health__server-heading">Nightly schedule</h3>
      <ul class="admin-health__schedule">
        <% @schedule.each do |key, task| %>
          <li><span><%= key.to_s.humanize %></span> <span><%= admin_schedule_label(task[:schedule]) %></span></li>
        <% end %>
      </ul>
      <p class="admin-health__hint">
        From <code>config/recurring.yml</code>. The sweep runs before cleanup on purpose: cleanup can only
        delete runs that have ended, and the sweep is what ends an abandoned one.
      </p>

      <h3 class="admin-health__server-heading">Commands</h3>
      <dl class="admin-health__settings">
        <div>
          <dt><code>bin/rails scenarios:sweep_idle DRY_RUN=1</code></dt>
          <dd>Preview what the next sweep would settle, without writing</dd>
        </div>
        <div>
          <dt><code>bin/rails scenarios:sweep_idle cleanup:scenarios cleanup:drafts</code></dt>
          <dd>Run tonight's sweep and cleanup now</dd>
        </div>
      </dl>
      <h3 class="admin-health__server-heading">When nightly jobs stall</h3>
      <%# Steps 1 and 2 hold however the app is deployed: Solid Queue runs inside
          Puma, and Puma's tmp_restart plugin restarts both (spec Q70). How the
          container itself restarts lives with the deployment, not in this repo. %>
      <ol class="admin-health__steps">
        <li>
          <p>Check a worker is reporting. Nothing listed, or nothing in the last <%= SolidQueue.process_alive_threshold.in_minutes.to_i %> minutes, means it is down or stuck:</p>
          <code>bin/rails runner 'puts SolidQueue::Process.pluck(:kind, :hostname, :last_heartbeat_at)'</code>
        </li>
        <li>
          <p>Restart it in place, inside the app container. This restarts Puma, and Puma restarts the worker:</p>
          <code>bin/rails restart</code>
        </li>
        <li><p>Still stalled? Restart the app container itself, the way your platform restarts it.</p></li>
      </ol>
    </div>
  </details>
</div>
