<%# locals: (nodes:, field_name:, selected_ids: []) %>
<%# Every group with its full path, filterable by any part of that path.
    Flat and indented by depth rather than an expandable tree: at hundreds of
    nested department groups, typing beats expanding, and a match needs no
    ancestors shown because its path already names them. nodes come from
    Group.tree_nodes, so the whole list costs one query. Reused by every admin
    group picker. %>
<div class="group-picker" data-controller="group-picker">
  <% if nodes.any? %>
    <div class="group-picker__search">
      <%= icon "magnifying-glass", class: "icon icon--sm group-picker__search-icon" %>
      <input type="search" class="form-input group-picker__filter" placeholder="Filter groups…"
             autocomplete="off" aria-label="Filter groups"
             data-group-picker-target="filter"
             data-action="input->group-picker#filter keydown.enter->group-picker#ignoreEnter">
    </div>

    <ul class="group-picker__list" role="list">
      <% nodes.each do |node| %>
        <li class="group-picker__option" style="--depth: <%= node.depth %>;"
            data-group-picker-target="option" data-path="<%= node.path.downcase %>">
          <label class="group-picker__label">
            <input type="checkbox" name="<%= field_name %>" value="<%= node.id %>" class="form-checkbox"
                   <%= "checked" if selected_ids.include?(node.id) %>>
            <span class="group-picker__name"><%= node.name %></span>
            <% if node.depth.positive? %>
              <span class="group-picker__path"><%= node.path %></span>
            <% end %>
          </label>
        </li>
      <% end %>
    </ul>

    <p class="form-hint group-picker__empty is-hidden" data-group-picker-target="empty">No group matches that filter.</p>
  <% else %>
    <p class="form-hint">No groups yet. Create one under Groups first.</p>
  <% end %>
</div>
